// OrgChain LOCAL database structure. No records or credential values.
// Only database-declared relationships are included.
Project OrgChainLocal {
  database_type: 'MySQL'
}

Table "votingsystem"."activity_compliance_docs" {
  "id" "bigint unsigned" [pk, not null, increment]
  "org_activity_id" "bigint unsigned" [null]
  "submission_id" "bigint unsigned" [null]
  "doc_key" "varchar(255)" [not null]
  "title" "varchar(255)" [not null]
  "status" "varchar(40)" [not null]
  "returned_to" "varchar(40)" [null]
  "remarks" "text" [null]
  "created_at" "timestamp" [null]
  "updated_at" "timestamp" [null]
  indexes {
    ("org_activity_id") [name: "activity_compliance_docs_org_activity_id_foreign"]
    ("submission_id") [name: "activity_compliance_docs_submission_id_foreign"]
  }
}

Table "votingsystem"."activity_registrations" {
  "id" "bigint unsigned" [pk, not null, increment]
